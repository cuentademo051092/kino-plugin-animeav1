    { "id": "romance", "name": "Romance / Comedia", "type": "tv" },
    { "id": "fantasia", "name": "Fantasía / Isekai", "type": "tv" },
    { "id": "scifi", "name": "Ciencia Ficción / Sobrenatural", "type": "tv" },
    { "id": "aventura", "name": "Aventura / Drama", "type": "tv" },
    { "id": "ecchi", "name": "Ecchi / Seinen", "type": "tv" }
