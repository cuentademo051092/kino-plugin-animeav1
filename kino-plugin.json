{
  "id": "animeav1",
  "name": "AnimeAV1",
  "version": "1.3.1",
  "apiVersion": 4,
  "entry": "plugin.js",
  "description": "Anime en español latino (y subtitulado si no hay) desde animeav1.com, con catálogo en Inicio y Categorías. Usa HLS, Voe o MP4Upload según haya.",
  "hosts": [
    "animeav1.com",
    "cdn.animeav1.com",
    "voe.sx",
    "jeremyparticipantanything.com",
    "*.zilla-networks.com",
    "player.zilla-networks.com",
    "teresapoliticallearn.com",
    "mp4upload.com",
    "*.mp4upload.com"
  ],
  "streamHosts": "any",
  "capabilities": [
    "home",
    "browse",
    "search",
    "episodes",
    "resolve"
  ],
  "settings": [
    {
      "key": "idioma",
      "label": "Idioma",
      "type": "select",
      "default": "dub-sub",
      "options": [
        {
          "value": "dub",
          "label": "Solo latino"
        },
        {
          "value": "dub-sub",
          "label": "Latino, o subtitulado si no hay"
        },
        {
          "value": "sub",
          "label": "Solo subtitulado"
        }
      ]
    },
    {
      "key": "servidor",
      "label": "Servidor preferido",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Automático (HLS, luego Voe y MP4Upload)"
        },
        {
          "value": "voe",
          "label": "Voe primero (720p)"
        },
        {
          "value": "mp4upload",
          "label": "MP4Upload primero (1080p AV1, celular)"
        }
      ]
    }
  ]
}