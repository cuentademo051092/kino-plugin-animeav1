{
  "id": "animeav1",
  "name": "AnimeAV1",
  "version": "1.2.0",
  "apiVersion": 4,
  "entry": "plugin.js",
  "description": "Anime en español latino y subtitulado desde animeav1.com con catálogos y selección de calidades.",
  "hosts": [
    "animeav1.com",
    "*.animeav1.com",
    "cdn.animeav1.com",
    "voe.sx",
    "*.voe.sx",
    "teresapoliticallearn.com",
    "*.teresapoliticallearn.com",
    "jeremyparticipantanything.com",
    "*.jeremyparticipantanything.com",
    "mp4upload.com",
    "*.mp4upload.com"
  ],
  "streamHosts": "any",
  "capabilities": ["search", "episodes", "resolve", "catalog"],
  "catalogs": [
    { "id": "ultimos", "name": "Últimos Episodios" },
    { "id": "emision", "name": "En Emisión" },
    { "id": "populares", "name": "Animes Populares" },
    { "id": "peliculas", "name": "Películas" },
    { "id": "series", "name": "Series y Animes" }
  ],
  "settings": [
    {
      "key": "idioma",
      "label": "Idioma preferido",
      "type": "select",
      "default": "dub",
      "options": [
        { "value": "dub", "label": "Solo latino" },
        { "value": "dub-sub", "label": "Latino, o subtitulado si no hay" },
        { "value": "sub", "label": "Solo subtitulado" }
      ]
    }
  ]
}
